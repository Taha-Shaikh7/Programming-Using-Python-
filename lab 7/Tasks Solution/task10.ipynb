   "source": [
    "import numpy as np\n",
    "arr=np.arange(1,21)\n",
    "even_num=arr[arr%2==0]\n",
    "print(\"all even numbers:\",even_num)\n",
    "print(\"square those even numbers:\",np.square(even_num))\n",
    "\n"
