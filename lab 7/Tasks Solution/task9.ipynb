    "import numpy as np\n",
    "temp=np.array([31,34,29,36,33,38,30])\n",
    "averg=temp.mean()\n",
    "print(\"Average temp:\",averg)\n",
    "print(\"highest temp:\",temp.max())\n",
    "print(\"temperatures above the average:\",temp[temp>averg])"
   ]
