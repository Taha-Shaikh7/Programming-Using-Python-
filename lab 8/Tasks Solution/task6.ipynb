    "import matplotlib.pyplot as plt\n",
    "days=[1,2,3,4,5,6,7]\n",
    "temp=[22,32,12,43,53,54,21]\n",
    "plt.suptitle(\"Temperature of seven days\")\n",
    "plt.plot(days,temp,color=\"blue\",marker=\"o\",)\n",
    "plt.xlabel(\"Days\")\n",
    "plt.ylabel(\"Temperature\")\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
