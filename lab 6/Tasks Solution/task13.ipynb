    "import pandas as pd\n",
    "df1 = pd.DataFrame({'ID': [1, 2, 3], 'Name': ['A', 'B', 'C']})\n",
    "df2 = pd.DataFrame({'ID': [1, 2, 4], 'Score': [80, 90, 85]})\n",
    "\n",
    "pd.merge(df1, df2, on='ID', how='outer')"
